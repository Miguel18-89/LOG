// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String           @id @default(uuid())
  name                    String
  email                   String           @unique
  password                String
  role                    Int              @default(0) //0=user, 1=manager, 2=admin
  is_active               Boolean          @default(true)
  created_at              DateTime         @default(now())
  updated_at              DateTime         @updatedAt
  pin                     String?          @unique
  resetToken              String?
  resetTokenExp           DateTime?
  approved                Boolean          @default(false)
  passwordChangedAt       DateTime?
  hourlyRate              Float?
  createdStores           Store[]          @relation("CreatedByUser")
  updatedStores           Store[]          @relation("UpdatedByUser")
  updatedSurveys          Survey[]         @relation("UpdatedByUser")
  updatedProvisioning     Provisioning[]   @relation("UpdatedByUser")
  updatedPhase1           Phase1[]         @relation("UpdatedByUser")
  updatedPhase2           Phase2[]         @relation("UpdatedByUser")
  updatedComments         Comments[]       @relation("CreatedByUser")
  updatedDocuments        Documents[]      @relation("uploadedByUser")
  overtimeRecords         OvertimeRecord[] @relation("OvertimeByUser")
  rmaRecords              RMA[]            @relation("RMAByUser")
  rmaUpdates              RMAUpdate[]      @relation("RMAUpdateByUser")
  vehicles                Vehicle[]        @relation("VehicleByUser")
  tireChanges             TireChange[]     @relation("TireChangeByUser")
  oilChanges              OilChange[]      @relation("OilChangeByUser")
  vehicleRepairs          VehicleRepair[]  @relation("VehicleRepairByUser")
  employees               Employee[]       @relation("EmployeeByUser")
  trainings               Training[]       @relation("TrainingByUser")
  vacationRequests        VacationRequest[] @relation("VacationByUser")
  vacationApprovals       VacationRequest[] @relation("VacationApprovedByUser")
  hourBankEntries         HourBankEntry[]  @relation("HourBankByUser")
  workOrders              WorkOrder[]      @relation("WorkOrderByUser")
  workOrderDocuments      WorkOrderDocument[] @relation("WorkOrderDocByUser")
}

model Store {
  id                      String         @id @default(uuid())
  storeName               String
  storeNumber             Int            @unique
  storeAddress            String
  storeRegion             String
  storeInspectorName      String
  storeInspectorContact   Int
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  created_by              String
  createdBy               User           @relation("CreatedByUser", fields: [created_by], references: [id])
  updated_by              String?
  updatedBy               User?          @relation("UpdatedByUser", fields: [updated_by], references: [id])
  storeSurveys            Survey[]       @relation("surveyFromStore")
  storeProvisioning       Provisioning[] @relation("ProvisioningFromStore")
  storePhase1             Phase1[]       @relation("Phase1FromStore")
  storePhase2             Phase2[]       @relation("Phase2FromStore")
  comments                Comments[]     @relation("CommentsFromStore") 
  documents               Documents[]     @relation("DocumentsFromStore") 
}

model Survey {
  id                       String    @id @default(uuid())
  surveyHasFalseCeilling   Boolean?
  surveyMetalFalseCeilling Boolean?
  surveyCheckoutCount      Int?
  surveyHasElectronicGates Boolean?
  surveyArea               Int?
  surveyPhase1Date         DateTime?
  surveyPhase1Type         String?
  surveyPhase2Date         DateTime?
  surveyPhase2Type         String?
  surveyOpeningDate        DateTime?
  surveyHeadsets           String?
  surveyHasBread           Boolean?
  surveyHasChicken         Boolean?
  surveyHasCodfish         Boolean?
  surveyHasNewOvens        Boolean?
  status                   Int       @default(0) //0 = not init 1=partial 2=Completed
  updated_at               DateTime  @updatedAt
  updated_by               String?
  updatedBy                User?     @relation("UpdatedByUser", fields: [updated_by], references: [id])
  store_id                 String    @unique
  storeId                  Store     @relation("surveyFromStore", fields: [store_id], references: [id], onDelete: Cascade)
}

model Provisioning {
  id                      String    @id @default(uuid())
  ordered                 Boolean?
  trackingNumber          String?
  received                Boolean?
  validated               Boolean?
  status                  Int       @default(0) //0=not init(red), 1=On the way(yellow), 2=Validated(green)
  updated_at              DateTime? @updatedAt
  updated_by              String?
  updatedBy               User?     @relation("UpdatedByUser", fields: [updated_by], references: [id])
  store_id                String    @unique
  storeId                 Store     @relation("ProvisioningFromStore", fields: [store_id], references: [id], onDelete: Cascade)
}

model Phase1 {
  id                      String    @id @default(uuid())
  cablesSalesArea         Boolean   @default(false)
  cablesBakery            Boolean   @default(false)
  cablesWarehouse         Boolean   @default(false)
  cablesBackoffice        Boolean   @default(false)
  speakersSalesArea       Boolean   @default(false)
  speakersBakery          Boolean   @default(false)
  speakersWarehouse       Boolean   @default(false)
  speakersBackoffice      Boolean   @default(false)
  status                  Int       @default(0) //0 = not init 1=partial 2=Completed
  updated_at              DateTime? @updatedAt
  updated_by              String?
  updatedBy               User?     @relation("UpdatedByUser", fields: [updated_by], references: [id])
  store_id                String    @unique
  storeId                 Store     @relation("Phase1FromStore", fields: [store_id], references: [id], onDelete: Cascade)
}

model Phase2 {
  id                      String    @id @default(uuid())
  kls                     Boolean   @default(false)
  acrylics                Boolean   @default(false)
  hotButtons              Boolean   @default(false)
  eas                     Boolean   @default(false)
  tiko                    Boolean   @default(false)
  ovens                   Boolean   @default(false)
  quailDigital            Boolean   @default(false)
  smc                     Boolean   @default(false)
  amplifier               Boolean   @default(false)
  tests                   Boolean   @default(false)
  status                  Int       @default(0) //0 = not init 1=partial 2=Completed
  updated_at              DateTime? @updatedAt
  updated_by              String?
  updatedBy               User?     @relation("UpdatedByUser", fields: [updated_by], references: [id])
  store_id                String    @unique
  storeId                 Store     @relation("Phase2FromStore", fields: [store_id], references: [id], onDelete: Cascade)
}

model Comments {
  id                      String @id @default(uuid())
  store_id                String
  storeId                 Store  @relation("CommentsFromStore", fields: [store_id], references: [id],onDelete: Cascade)
  created_by              String
  createdBy               User   @relation("CreatedByUser", fields: [created_by], references: [id])
  created_at              DateTime? @default(now())
  updated                 Boolean? @default(false)
  message                 String
}

model Documents {
  id                      String   @id @default(uuid())
  filename                String
  originalName            String
  path                    String
  uploadedAt              DateTime @default(now())
  uploadedBy              User     @relation("uploadedByUser", fields: [uploaded_by], references: [id])
  uploaded_by             String
  store_id                String
  storeId                 Store  @relation("DocumentsFromStore", fields: [store_id], references: [id],onDelete: Cascade)
}

model OvertimeRecord {
  id           String   @id @default(uuid())
  date         DateTime
  recordType   String   @default("trabalho") // trabalho | ferias | falta | feriado
  entryTime    String?
  exitTime     String?
  dinner       Boolean  @default(false)
  weekendLunch Boolean  @default(false)
  hours50      Float?
  hours75      Float?
  hours100     Float?
  nightType    String?
  client       String?
  obra         String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  user_id      String
  createdBy    User     @relation("OvertimeByUser", fields: [user_id], references: [id])
}

model HourBankEntry {
  id          String   @id @default(uuid())
  type        String   // ajuste | credito | despesa
  date        DateTime
  description String?
  hours       Float?   // só em 'credito': total de horas passadas (50%+75%+100%)
  hours100    Float?   // só em 'credito': horas a 100% incluídas neste crédito
  hours75     Float?   // só em 'credito': horas a 75% incluídas neste crédito
  hours50     Float?   // só em 'credito': horas a 50% incluídas neste crédito
  hourlyRate  Float?   // só em 'credito': taxa base aplicada no momento (snapshot)
  value       Float    // € com sinal: positivo em ajuste/credito, negativo em despesa
  month       Int?     // só em 'credito'
  year        Int?     // só em 'credito'
  created_at  DateTime @default(now())
  user_id     String
  createdBy   User     @relation("HourBankByUser", fields: [user_id], references: [id])
}

model RMA {
  id             String      @id @default(uuid())
  rmaNumber      Int         @unique @default(autoincrement())
  openDate       DateTime    @default(now())
  brand          String
  model          String
  serialNumber   String
  fault          String
  client         String
  location       String
  requestedBy    String
  status         String      @default("no_cliente")
  repairLocation String?
  updates        RMAUpdate[]
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  user_id        String
  createdBy      User        @relation("RMAByUser", fields: [user_id], references: [id])
}

model RMAUpdate {
  id         String   @id @default(uuid())
  message    String
  created_at DateTime @default(now())
  rma_id     String
  rma        RMA      @relation(fields: [rma_id], references: [id], onDelete: Cascade)
  user_id    String
  createdBy  User     @relation("RMAUpdateByUser", fields: [user_id], references: [id])
}

model Vehicle {
  id                  String          @id @default(uuid())
  brand               String
  model               String
  plate               String          @unique
  registrationYear    Int
  registrationMonth   Int
  nextInspectionDate  DateTime?
  insuranceExpiryDate DateTime?
  tireSize            String?
  tireChanges         TireChange[]
  oilChanges          OilChange[]
  repairs             VehicleRepair[]
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  user_id             String
  createdBy           User            @relation("VehicleByUser", fields: [user_id], references: [id])
}

model TireChange {
  id         String   @id @default(uuid())
  date       DateTime
  location   String
  km         Int
  type       String
  notes      String?
  created_at DateTime @default(now())
  vehicle_id String
  vehicle    Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  user_id    String
  createdBy  User     @relation("TireChangeByUser", fields: [user_id], references: [id])
}

model OilChange {
  id         String   @id @default(uuid())
  date       DateTime
  location   String
  km         Int
  notes      String?
  created_at DateTime @default(now())
  vehicle_id String
  vehicle    Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  user_id    String
  createdBy  User     @relation("OilChangeByUser", fields: [user_id], references: [id])
}

model VehicleRepair {
  id             String   @id @default(uuid())
  date           DateTime
  fault          String
  repairLocation String
  km             Int
  notes          String?
  created_at     DateTime @default(now())
  vehicle_id     String
  vehicle        Vehicle  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade)
  user_id        String
  createdBy      User     @relation("VehicleRepairByUser", fields: [user_id], references: [id])
}

model Employee {
  id                   String     @id @default(uuid())
  fullName             String
  nif                  String?    @unique
  cc                   String?    @unique
  niss                 String?    @unique
  birthDate            DateTime?
  address              String?
  phone                String?
  personalEmail        String?
  workEmail            String?
  emergencyContactName  String?
  emergencyContactRel   String?
  emergencyContactPhone String?
  admissionDate         DateTime?
  contractType          String?
  jobCategory           String?
  iban                  String?
  insurancePolicy      String?
  medicalFitnessDate         DateTime?
  medicalFitnessFilename     String?
  medicalFitnessOriginalName String?
  medicalFitnessFilePath     String?
  trainings                  Training[]
  vacations                  VacationRequest[]
  workOrders                 WorkOrder[]
  created_at                 DateTime   @default(now())
  updated_at                 DateTime   @updatedAt
  user_id                    String
  createdBy                  User       @relation("EmployeeByUser", fields: [user_id], references: [id])
}

model Training {
  id           String   @id @default(uuid())
  name         String
  date         DateTime
  hours        Float
  filename     String?
  originalName String?
  filePath     String?
  employee_id  String
  employee     Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  created_at   DateTime @default(now())
  user_id      String
  createdBy    User     @relation("TrainingByUser", fields: [user_id], references: [id])
}

model VacationRequest {
  id          String    @id @default(uuid())
  startDate   DateTime
  endDate     DateTime
  status          String    @default("pendente")
  notes           String?
  rejectionReason String?
  employee_id String
  employee    Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  approved_by String?
  approvedAt  DateTime?
  approvedBy  User?     @relation("VacationApprovedByUser", fields: [approved_by], references: [id])
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  created_by  String
  createdBy   User      @relation("VacationByUser", fields: [created_by], references: [id])
}

// Folha de obra: o que foi feito no terreno, com que materiais, por quem, e confirmado pelo cliente.
model WorkOrder {
  id            String    @id @default(uuid())
  orderNumber   Int       @unique @default(autoincrement())
  client        String
  obra          String
  type          String    // instalacao | manutencao | reparacao
  status        String    @default("em_curso") // em_curso | concluida
  date          DateTime
  startTime     String?   // "HH:MM"
  endTime       String?   // "HH:MM"
  tasks         String
  materials     String
  notes         String?
  signatureData String?   // PNG em data URI base64
  signedByName  String?
  signedAt      DateTime?
  technicians   Employee[]
  documents     WorkOrderDocument[]
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  user_id       String
  createdBy     User      @relation("WorkOrderByUser", fields: [user_id], references: [id])
}

model WorkOrderDocument {
  id           String    @id @default(uuid())
  kind         String    @default("documento") // documento | foto
  filename     String
  originalName String
  path         String
  uploadedAt   DateTime  @default(now())
  workOrder_id String
  workOrder    WorkOrder @relation(fields: [workOrder_id], references: [id], onDelete: Cascade)
  uploaded_by  String
  uploadedBy   User      @relation("WorkOrderDocByUser", fields: [uploaded_by], references: [id])
}
