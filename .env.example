# Modelo de configuração. Copiar para `.env` e preencher.
# Nenhum valor real aqui — este ficheiro vai para o repositório.

# ── Base de dados ────────────────────────────────────────────────────────────
DATABASE_URL="postgres://utilizador:password@localhost:5432/logProject"

# ── Autenticação ─────────────────────────────────────────────────────────────
JWT_SECRET=gerar-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=8h
# Sal aplicado aos PIN antes do hash.
PIN_PEPPER=gerar-outra-chave-aleatoria

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=conta@exemplo.pt
# No Gmail, uma "password de aplicação", não a password da conta.
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Nome que o destinatário vê como remetente. O endereço é sempre o SMTP_USER:
# o Gmail rejeita um From com endereço diferente da conta autenticada.
# Sem esta variável, usa-se "LOG - EMG".
MAIL_FROM_NAME="LOG - EMG"

# Destinatário dos mapas de horas extra.
OVERTIME_RECIPIENT_EMAIL=destinatario@exemplo.pt

# ── Frontend ─────────────────────────────────────────────────────────────────
# Origens aceites pelo CORS, separadas por vírgula. A primeira é a usada para
# construir as ligações nos emails.
FRONTEND_URL=https://log.exemplo.pt,http://localhost:5173
